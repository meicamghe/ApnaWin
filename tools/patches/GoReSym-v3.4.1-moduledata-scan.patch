+package objfile
+
+import "testing"
+
+func TestFindModuleDataOffsetSkipsIgnoredFirstMatch(t *testing.T) {
+	data := []byte("xPCLNyyPCLNz")
+	got := findModuleDataOffset(data, []byte("PCLN"), uint64(len(data)), 0x1000, []uint64{0x1001})
+	if got != 7 {
+		t.Fatalf("got offset %d, want 7", got)
+	}
+}
+
+func TestFindModuleDataOffsetKeepsFirstValidMatch(t *testing.T) {
+	data := []byte("xPCLNyyPCLNz")
+	got := findModuleDataOffset(data, []byte("PCLN"), uint64(len(data)), 0x1000, nil)
+	if got != 1 {
+		t.Fatalf("got offset %d, want 1", got)
+	}
+}
+
+func TestFindModuleDataOffsetSkipsMultipleIgnoredMatches(t *testing.T) {
+	data := []byte("xPCLNyPCLNzPCLN")
+	ignored := []uint64{0x1001, 0x1006}
+	got := findModuleDataOffset(data, []byte("PCLN"), uint64(len(data)), 0x1000, ignored)
+	if got != 11 {
+		t.Fatalf("got offset %d, want 11", got)
+	}
+}
+
+func TestFindModuleDataOffsetReturnsNotFound(t *testing.T) {
+	data := []byte("no candidate here")
+	got := findModuleDataOffset(data, []byte("PCLN"), uint64(len(data)), 0x1000, nil)
+	if got != -1 {
+		t.Fatalf("got offset %d, want -1", got)
+	}
+}
+func TestFindModuleDataOffsetRejectsCrossSectionMatch(t *testing.T) {
+	data := []byte("xxPCLNyyPCLN")
+	got := findModuleDataOffset(data, []byte("PCLN"), 5, 0x1000, nil)
+	if got != -1 {
+		t.Fatalf("got offset %d, want -1", got)
+	}
NaN
+
