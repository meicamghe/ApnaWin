+// findModuleDataOffset returns the first non-ignored occurrence of the
+// pclntab pointer that begins inside the current section. Unlike bytes.Index,
+// it continues searching the same section when an earlier occurrence is in
+// ignorelist. sectionAddr is the section's virtual address.
+func findModuleDataOffset(data, signature []byte, sectionSize, sectionAddr uint64, ignorelist []uint64) int {
+	if len(signature) == 0 {
+		return -1
+	}
+	searchFrom := 0
+	for searchFrom < len(data) {
+		relative := bytes.Index(data[searchFrom:], signature)
+		if relative < 0 {
+			return -1
+		}
+		idx := searchFrom + relative
+		if uint64(idx)+uint64(len(signature)) > sectionSize {
+			return -1
+		}
+		candidateVA := sectionAddr + uint64(idx)
+		ignored := false
+		for _, ignore := range ignorelist {
+			if ignore == candidateVA {
+				ignored = true
+				break
+			}
+		}
+		if !ignored {
+			return idx
+		}
+		searchFrom = idx + 1
+	}
+	return -1
+}
